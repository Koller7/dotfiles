{
    "positionX": "right",
    "positionY": "top",

    "layer": "overlay",
    "control-center-layer": "top",

    "notification-window-width": 380,
    "notification-icon-size": 48,

    "notification-2fa-action": true,
    "notification-inline-replies": true,

    "timeout": 5,
    "timeout-low": 3,
    "timeout-critical": 0,

    "fit-to-screen": true,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",

    "control-center-width": 400,
    "control-center-height": 700,

    "transition-time": 200,

    "notification-grouping": true,
    "script-fail-notify": true,

    "widgets": [
        "title",
        "dnd",
        "notifications",
        "mpris",
        "volume",
        "backlight",
        "buttons-grid"
    ],

    "widget-config": {
        "title": {
            "text": "Notificações",
            "clear-all-button": true,
            "button-text": "Limpar"
        },

        "dnd": {
            "text": "Não perturbe"
        },

        "mpris": {
            "image-size": 64,
            "image-radius": 8
        },

        "volume": {
            "show-volume": true,
            "show-per-app": true,
            "expand-button-label": "Expandir"
        },

        "backlight": {
            "label": "Brilho"
        },

        "buttons-grid": {
            "actions": [
                {
                    "label": "󰂯",
                    "type": "command",
                    "command": "blueman-manager"
                },
                {
                    "label": "󰖩",
                    "type": "command",
                    "command": "nm-connection-editor"
                },
                {
                    "label": "󰍬",
                    "type": "command",
                    "command": "pavucontrol"
                },
                {
                    "label": "󰐥",
                    "type": "command",
                    "command": "wlogout"
                }
            ]
        }
    }
}
